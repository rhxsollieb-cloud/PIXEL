# 只在后端读取；复制为 .env 后填写。不要加入 VITE_ 前缀。
ELEVENLABS_API_KEY=
OPENROUTER_API_KEY=

# Pixel 桌面宿主监听端口统一在此范围分配；只监听 loopback，不新增网页部署服务。
# 不修改 Seafile / OpenRouter / ElevenLabs 的出站服务地址或端口。
FIREWALL_OPEN_PORT_RANGE=12000-12100
PORT_RANGE_START=12000
PORT_RANGE_END=12100

# 项目、历史、回执、任务、声纹操作记录及媒体统一写入 Seafile；没有本地项目/资源回退。
SEAFILE_URL=
SEAFILE_PORT=
# 推荐为团队专用账户配置 Token；也兼容现有管理员邮箱/密码配置。
SEAFILE_TOKEN=
SEAFILE_ADMIN_EMAIL=
SEAFILE_ADMIN_PASSWORD=
# 指定现有团队共享库 ID；留空时唯一匹配下列库名，没有匹配才创建专用库。
SEAFILE_REPO_ID=
SEAFILE_LIBRARY_NAME=Pixel
SEAFILE_ROOT_PATH=/pixel
# Seafile 返回内部文件服务地址时，显式映射到可访问的外部文件入口（origin）。
# 仅允许映射配置认可的 origin 或 API 的同 hostname；账户 Token 不发送给文件服务。
SEAFILE_FILE_SERVER_URL=
# 如需保留另一个可访问的文件服务 origin，在此显式允许；不自动发现任意外部主机。
SEAFILE_ALLOWED_FILE_ORIGINS=
SEAFILE_TIMEOUT_MS=60000
SEAFILE_MAX_BYTES=536870912
