{
  "name": "pixel-core-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "description": "Pixel 本地像素风生成创作工作台",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "dev:server": "tsx src/server.ts",
    "desktop": "npm run build:desktop && node scripts/desktop.mjs",
    "desktop:launch": "node scripts/desktop.mjs",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "test:desktop": "npm run build:desktop && node --import tsx scripts/test-desktop.mjs",
    "test:desktop:smoke": "npm run build:desktop && node scripts/desktop.mjs --pixel-smoke",
    "test:packaged": "node scripts/test-packaged.mjs",
    "package:win": "npm run build:desktop && electron-builder --config electron-builder.json --win --x64 --publish never",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4310",
    "test:ui": "playwright test",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "timeline:text": "node --import tsx scripts/read-timeline-text.mjs",
    "example": "tsx examples/move-clip.ts",
    "models": "tsx examples/generate-media.ts --list",
    "generate": "tsx examples/generate-media.ts"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.71.0",
    "@openrouter/sdk": "^1.4.25",
    "ditherwave": "^0.1.0",
    "dotenv": "^18.0.6",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.3"
  }
}
