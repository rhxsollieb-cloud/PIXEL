{
  "name": "pixel-core-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pixel 视频生成软件核心契约和基类设计骨架",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "dev:server": "tsx src/server.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4310",
    "test:ui": "playwright test",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "example": "tsx examples/move-clip.ts",
    "models": "tsx examples/generate-media.ts --list",
    "generate": "tsx examples/generate-media.ts"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.71.0",
    "@openrouter/sdk": "^1.4.25",
    "dotenv": "^18.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.3"
  }
}
